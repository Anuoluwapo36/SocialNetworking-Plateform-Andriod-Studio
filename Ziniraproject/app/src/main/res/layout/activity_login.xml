<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/img"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
        android:paddingLeft="25dp"
        android:paddingTop="55dp"
        android:paddingRight="25dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/login"
            android:textColor="@color/black"
            android:textSize="50sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColorHint="@color/black"
            app:hintTextColor="@color/black"

            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/inputUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:padding="20dp"
                android:background="@drawable/radius"
                android:hint="@string/email"
                android:inputType="text"
                />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColorHint="@color/black"
            app:hintTextColor="@color/black"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:padding="20dp"
                android:background="@drawable/radius"
                android:hint="@string/password"
                android:inputType="textPassword"
                />


        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forget_password"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:padding="10dp"
            android:textSize="13sp"/>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginId"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:text="@string/login"
            android:padding="12dp"
            android:layout_gravity="center"
            android:background="@drawable/hover_login_button"
            android:textColor="@color/white"
            android:fontFamily="monospace"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/registerLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/signup_new_member"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/white"/>

  <include layout="@layout/lay_out_other_thridparty_signup"/>


    </LinearLayout>

    <ProgressBar
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:id="@+id/loginRequestLoadingProgressbar"
        android:layout_centerInParent="true"/>
    <TextView
        android:id="@+id/pleasewaitId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/please_wait"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="@color/white"
        android:layout_alignRight="@id/loginRequestLoadingProgressbar"
        android:layout_alignBottom="@id/loginRequestLoadingProgressbar"
        android:layout_alignLeft="@id/loginRequestLoadingProgressbar"/>


</RelativeLayout>