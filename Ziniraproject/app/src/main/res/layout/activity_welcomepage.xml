<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/woman"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="30dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textColor="@color/black"

            android:textStyle="bold"

            android:text="@string/welcome"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textColor="@color/black"
            android:layout_margin="20dp"
            android:textStyle="bold"
            android:text="@string/create_account"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_margin="8dp"
            android:text="@string/stay_connected"/>

        <Button
            android:id="@+id/buttonDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@drawable/roundshape"
            android:text="@string/start"
            android:textColor="@color/white"
            android:textAllCaps="false"/>

    </LinearLayout>


    <ProgressBar
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:id="@+id/startLoadingProgressbar"
        android:layout_centerInParent="true"/>
    <TextView
        android:id="@+id/pleaseWaitStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/please_wait"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="@color/white"
        android:layout_alignRight="@id/startLoadingProgressbar"
        android:layout_alignBottom="@id/startLoadingProgressbar"
        android:layout_alignLeft="@id/startLoadingProgressbar"/>


</RelativeLayout>