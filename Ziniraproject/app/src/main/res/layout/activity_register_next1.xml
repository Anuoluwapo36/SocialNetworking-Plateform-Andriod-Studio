<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/img"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:layout_centerHorizontal="true"
        android:paddingLeft="25dp"
        android:paddingTop="55dp"
        android:paddingRight="25dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/complete_registration"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColorHint="@color/black"
            app:hintTextColor="@color/black"

            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:padding="20dp"
                android:background="@drawable/radius"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColorHint="@color/black"
            app:hintTextColor="@color/black"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/inputUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:padding="20dp"
                android:background="@drawable/radius"
                android:hint="@string/username"
                android:inputType="textEmailAddress"
                />


        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColorHint="@color/black"
            app:hintTextColor="@color/black"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:padding="20dp"
                android:background="@drawable/radius"
                android:hint="@string/password"
                android:inputType="textPassword"
                />


        </com.google.android.material.textfield.TextInputLayout>


            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/isCheckId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginStart="30dp"
                android:text="@string/agreement_and_terms_and_conditions"
                />






        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonCreate"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:text="@string/create"
            android:padding="12dp"
            android:layout_gravity="center"
            android:background="@drawable/hover_login_button"
            android:textColor="@color/white"
            android:fontFamily="monospace"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"/>




    </LinearLayout>

    <ProgressBar
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:id="@+id/registerRequestLoadingProgressbar"
        android:layout_centerInParent="true"/>
    <TextView
        android:id="@+id/pleaseWaitId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/please_wait"
        android:textSize="15sp"
        android:gravity="center"
        android:textColor="@color/white"
        android:layout_alignRight="@id/registerRequestLoadingProgressbar"
        android:layout_alignBottom="@id/registerRequestLoadingProgressbar"
        android:layout_alignLeft="@id/registerRequestLoadingProgressbar"/>


</RelativeLayout>