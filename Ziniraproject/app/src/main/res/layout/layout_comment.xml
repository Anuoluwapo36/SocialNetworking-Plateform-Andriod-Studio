<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:shapeAppearance="@style/RoundedImageView"
        android:id="@+id/comment_profile_image"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        android:scaleType="centerCrop"
        android:background="@drawable/default_user_gray"
        app:strokeWidth="0.5dp"
        app:strokeColor="@color/gray"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/relLayout1"
        android:background="#18BFBFBF"
        android:layout_toRightOf="@id/comment_profile_image"
        android:layout_marginTop="15dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="majie"
                android:id="@+id/comment_username"
                android:layout_marginLeft="15dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="12sp"
                />



            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="comment area"
                android:id="@+id/comment_show"
                android:layout_below="@id/comment_username"
                android:layout_marginLeft="15dp"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:layout_marginTop="5dp"
                />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="comment area"
                android:id="@+id/playVoiceA"
                android:layout_toEndOf="@id/comment_show"
                android:src="@drawable/play"
                android:layout_below="@id/comment_username"
                android:textColor="@color/black"
                android:contentDescription="Play audio comment"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:textSize="12sp"
                android:layout_marginTop="5dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 20 likes"
                android:id="@+id/comment_likes"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_below="@id/comment_show"
                android:layout_marginLeft="15dp"
                android:textColor="@color/gray"
                android:textSize="12sp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" reply"
                android:id="@+id/commet_reply"
                android:textStyle="bold"
                android:layout_toRightOf="@id/comment_likes"
                android:layout_below="@id/comment_show"
                android:layout_marginTop="10dp"


                android:layout_marginLeft="14dp"
                android:textColor="@color/gray"
                android:textSize="12sp"
                />


            <ImageView
                android:id="@+id/ellipsesId"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:backgroundTint="@color/black"
                android:scaleType="centerInside"
                android:background="@android:color/transparent"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_ellipsis" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 3 days ago"
                android:id="@+id/comment_time"
                android:layout_below="@id/ellipsesId"
                android:textStyle="bold"

                android:layout_marginLeft="15dp"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:layout_alignParentEnd="true"
                />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:id="@+id/comment_like"
                android:scaleType="centerInside"
                android:padding="3dp"
                android:layout_alignParentRight="true"
                android:layout_below="@id/comment_time"
                android:src="@drawable/ic_heart_white"
                android:layout_marginTop="10dp"/>

        </RelativeLayout>



    </RelativeLayout>

</RelativeLayout>