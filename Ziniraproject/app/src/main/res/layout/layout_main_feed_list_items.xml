<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">




            <RelativeLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/relLayout1">

                <!-- Stack image and profile header -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- Post Image -->
                    <com.example.ziniraproject.until.SquareImageView
                        android:id="@+id/post_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profileImageId"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:scaleType="centerCrop"
                            android:padding="4dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="10dp"
                            app:strokeColor="@color/gray"
                            app:strokeWidth="0.5dp"
                            app:shapeAppearance="@style/RoundedImageView"
                            app:shapeAppearanceOverlay="@style/RoundedImageView" />

                        <TextView
                            android:id="@+id/usernameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="maje"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/black"
                            android:layout_toEndOf="@id/profileImageId"
                            android:layout_marginStart="10dp"
                            android:layout_centerVertical="true" />

                        <ImageView
                            android:id="@+id/ellipsesId"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:scaleType="centerInside"
                            android:background="@android:color/transparent"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_ellipsis" />
                    </RelativeLayout>
                </FrameLayout>
            </RelativeLayout>





            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/relLayout1"
                android:id="@+id/relLayout2"
                android:background="@color/white"
                android:padding="10dp"
                android:layout_marginBottom="50dp"
                >



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="users "
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:id="@+id/image_username"/>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" mountain #eart "
                    android:layout_below="@+id/image_username"
                    android:textSize="11sp"
                    android:textColor="@color/black"
                    android:id="@+id/image_caption"/>



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="liked by majie, james, boss  and 50 others"
                    android:textSize="11sp"
                    android:layout_below="@id/image_caption"
                    android:textColor="@color/black"
                    android:id="@+id/image_likes"/>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:id="@+id/relLayout3"
                    android:background="@color/white"
                    android:layout_below="@id/image_likes">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:id="@+id/heartLayout"
                        android:background="@color/white"
                        android:layout_centerVertical="true"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/image_heart_red"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_heart_red"
                            android:visibility="invisible"/>

                        <ImageView
                            android:id="@+id/image_heart_white"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:layout_centerInParent="true"
                            android:src="@drawable/ic_heart_white"
                            android:visibility="visible"/>




                    </FrameLayout>




                    <ImageView
                        android:id="@+id/speech_bubble"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_centerInParent="true"
                        android:layout_toRightOf="@id/heartLayout"
                        android:src="@drawable/ic_comment_action"
                        android:layout_centerVertical="true"
                        android:visibility="visible"/>



                    <ImageView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_share"
                        android:id="@+id/ic_share"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        />


                </RelativeLayout>





                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all 3 comment"
                    android:textSize="11sp"
                    android:layout_below="@id/relLayout3"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/gray"
                    android:id="@+id/image_comment_link"/>



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 days ago"
                    android:textSize="11sp"
                    android:layout_below="@id/image_comment_link"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/gray"
                    android:id="@+id/image_time_posted"/>







            </RelativeLayout>








</RelativeLayout>