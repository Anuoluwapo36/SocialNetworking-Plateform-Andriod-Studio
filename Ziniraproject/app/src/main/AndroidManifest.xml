        <activity android:name=".share.ShareActivity"
            android:exported="true"/>
        <activity android:name=".like.LikesActivity"
            android:exported="true"/>
        <activity android:name=".profile.ProfileActivity"
            android:exported="true"/>
        <activity android:name=".message.MessageActivity"
            android:exported="true"/>
        <activity android:name=".settings.AccountSettingsActivity"
            android:exported="true"/>

        <activity android:name=".login.RegisterActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true" />
        <activity android:name=".login.RegisterNextActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".login.RegisterDetailsActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".login.WelcomeLanding"/>
        <activity android:name=".create.CreateActivity"/>
        <activity android:name=".notification.NotificationActivity"/>
        <activity android:name=".share.NextActivity"/>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>

    </application>

</manifest>